datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String                       @id @default(uuid())
  email            String                       @unique
  passwordHash     String
  name             String
  role             String                       @default("USER") // USER, HOUSEHOLD_ADMIN, SYSTEM_ADMIN
  avatarUrl        String?
  householdId      String?
  household        Household?                   @relation(fields: [householdId], references: [id], onDelete: SetNull)
  memberships      HouseholdMember[]
  addedItems       GroceryItem[]                @relation("AddedBy")
  assignedItems    GroceryItem[]                @relation("AssignedTo")
  paidExpenses     Expense[]                    @relation("PaidBy")
  expenseSplits    ExpenseSplit[]
  uploadedReceipts Receipt[]
  purchases        PurchaseRecord[]
  alerts           PriceAlert[]
  savedProducts    SavedProduct[]
  ownedProducts    OwnedProduct[]
  documents        Document[]
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  @@index([householdId])
  @@index([email])
}

model Household {
  id                    String                 @id @default(uuid())
  name                  String
  inviteCode            String                 @unique
  createdById           String
  currency              String                 @default("EUR") // EUR, INR, USD
  users                 User[]
  members               HouseholdMember[]
  lists                 GroceryList[]
  expenses              Expense[]
  receipts              Receipt[]
  inventory             InventoryItem[]
  purchases             PurchaseRecord[]
  notifications         Notification[]
  alerts                PriceAlert[]
  savedProducts         SavedProduct[]
  ownedProducts         OwnedProduct[]
  documents             Document[]
  automationConfig      AutomationConfig?
  ocrEvaluations        OcrEvaluationRecord[]
  predictionEvaluations PredictionEvaluationRecord[]
  researchMetrics       ResearchMetric[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([inviteCode])
}

model HouseholdMember {
  id          String    @id @default(uuid())
  userId      String
  householdId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  role        String    @default("MEMBER") // ADMIN, MEMBER
  joinedAt    DateTime  @default(now())

  @@unique([userId, householdId])
  @@index([householdId])
  @@index([userId])
}

model GroceryList {
  id          String        @id @default(uuid())
  householdId String
  household   Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  title       String
  isDefault   Boolean       @default(true)
  items       GroceryItem[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([householdId])
}

model GroceryItem {
  id             String      @id @default(uuid())
  listId         String
  list           GroceryList @relation(fields: [listId], references: [id], onDelete: Cascade)
  name           String
  category       String      @default("GROCERY")
  quantity       Float       @default(1)
  unit           String      @default("pcs")
  estimatedPrice Float       @default(0)
  addedById      String
  addedBy        User        @relation("AddedBy", fields: [addedById], references: [id])
  assignedToId   String?
  assignedTo     User?       @relation("AssignedTo", fields: [assignedToId], references: [id])
  isPurchased    Boolean     @default(false)
  purchasedAt    DateTime?
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([listId])
  @@index([isPurchased])
}

model Receipt {
  id             String                @id @default(uuid())
  householdId    String
  household      Household             @relation(fields: [householdId], references: [id], onDelete: Cascade)
  uploadedById   String
  uploadedBy     User                  @relation(fields: [uploadedById], references: [id])
  storeName      String
  totalAmount    Float
  taxAmount      Float                 @default(0)
  currency       String                @default("EUR")
  receiptDate    DateTime              @default(now())
  imageUrl       String?
  rawOcrText     String?
  ocrConfidence  Float                 @default(85.0)
  items          ReceiptItem[]
  expenses       Expense[]
  purchases      PurchaseRecord[]
  evaluations    OcrEvaluationRecord[]
  createdAt      DateTime              @default(now())

  @@index([householdId])
  @@index([receiptDate])
}

model ReceiptItem {
  id               String  @id @default(uuid())
  receiptId        String
  receipt          Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  name             String
  category         String  @default("GROCERY")
  price            Float
  quantity         Float   @default(1)
  confidence       Float   @default(85.0)
  wasUserCorrected Boolean @default(false)

  @@index([receiptId])
}

model Expense {
  id          String         @id @default(uuid())
  householdId String
  household   Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  paidById    String
  paidBy      User           @relation("PaidBy", fields: [paidById], references: [id])
  title       String
  amount      Float
  currency    String         @default("EUR")
  category    String         @default("GROCERY")
  date        DateTime       @default(now())
  receiptId   String?
  receipt     Receipt?       @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  splits      ExpenseSplit[]
  createdAt   DateTime       @default(now())

  @@index([householdId])
  @@index([date])
}

model ExpenseSplit {
  id        String    @id @default(uuid())
  expenseId String
  expense   Expense   @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Float
  isSettled Boolean   @default(false)
  settledAt DateTime?

  @@index([expenseId])
  @@index([userId])
}

model InventoryItem {
  id              String    @id @default(uuid())
  householdId     String
  household       Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name            String
  category        String    @default("PANTRY")
  quantity        Float     @default(1)
  unit            String    @default("pcs")
  minThreshold    Float     @default(1)
  location        String    @default("PANTRY")
  status          String    @default("IN_STOCK")
  expiryDate      DateTime?
  lastRestockedAt DateTime  @default(now())
  lastConsumedAt  DateTime?
  updatedAt       DateTime  @updatedAt

  @@index([householdId])
  @@index([status])
  @@index([location])
}

model PurchaseRecord {
  id           String    @id @default(uuid())
  householdId  String
  household    Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  receiptId    String?
  receipt      Receipt?  @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  productName  String
  category     String    @default("GROCERY")
  quantity     Float     @default(1)
  unitPrice    Float     @default(0)
  totalPrice   Float     @default(0)
  currency     String    @default("EUR")
  storeName    String    @default("Grocery Store")
  purchaseDate DateTime  @default(now())
  createdAt    DateTime  @default(now())

  @@index([householdId])
  @@index([productName])
  @@index([purchaseDate])
}

model Notification {
  id          String    @id @default(uuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  userId      String?
  title       String
  message     String
  type        String    @default("INFO")
  isRead      Boolean   @default(false)
  link        String?
  createdAt   DateTime  @default(now())

  @@index([householdId])
}

model Product {
  id             String         @id @default(uuid())
  name           String
  normalizedName String         @unique
  brand          String?
  category       String         @default("GENERAL")
  description    String?
  imageUrl       String?
  specsJson      String?
  storeProducts  StoreProduct[]
  alerts         PriceAlert[]
  savedBy        SavedProduct[]
  ownedBy        OwnedProduct[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([normalizedName])
}

model Store {
  id            String         @id @default(uuid())
  name          String         @unique
  logoUrl       String?
  website       String?
  location      String?
  rating        Float          @default(4.5)
  storeProducts StoreProduct[]
  createdAt     DateTime       @default(now())
}

model StoreProduct {
  id           String         @id @default(uuid())
  productId    String
  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  storeId      String
  store        Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeSku     String?
  url          String?
  currentPrice Float
  unitPrice    Float          @default(0)
  unit         String         @default("pcs")
  currency     String         @default("EUR")
  isAvailable  Boolean        @default(true)
  priceHistory PriceHistory[]
  lastUpdated  DateTime       @default(now())

  @@unique([productId, storeId])
  @@index([productId])
  @@index([storeId])
}

model PriceHistory {
  id             String       @id @default(uuid())
  storeProductId String
  storeProduct   StoreProduct @relation(fields: [storeProductId], references: [id], onDelete: Cascade)
  price          Float
  unitPrice      Float        @default(0)
  currency       String       @default("EUR")
  recordedAt     DateTime     @default(now())

  @@index([storeProductId])
  @@index([recordedAt])
}

model PriceAlert {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  targetPrice Float
  currency    String    @default("EUR")
  isTriggered Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([householdId])
  @@index([productId])
}

model SavedProduct {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  notes       String?
  createdAt   DateTime  @default(now())

  @@index([householdId])
}

model OwnedProduct {
  id                 String    @id @default(uuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  householdId        String
  household          Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  productId          String?
  product            Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  name               String
  category           String    @default("ELECTRONICS")
  brand              String?
  model              String?
  serialNumber       String?
  purchaseDate       DateTime  @default(now())
  purchasePrice      Float     @default(0)
  currency           String    @default("EUR")
  storeName          String?
  receiptUrl         String?
  manualUrl          String?
  warrantyMonths     Int       @default(12)
  warrantyExpiryDate DateTime?
  repairHistoryJson  String?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([householdId])
  @@index([warrantyExpiryDate])
}

model Document {
  id                 String    @id @default(uuid())
  householdId        String
  household          Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  uploadedById       String
  uploadedBy         User      @relation(fields: [uploadedById], references: [id])
  title              String
  docType            String    @default("RECEIPT")
  fileUrl            String?
  vendorName         String?
  amount             Float     @default(0)
  currency           String    @default("EUR")
  docDate            DateTime  @default(now())
  warrantyExpiryDate DateTime?
  parsedText         String?
  metadataJson       String?
  createdAt          DateTime  @default(now())

  @@index([householdId])
  @@index([docType])
}

model AutomationConfig {
  id                  String    @id @default(uuid())
  householdId         String    @unique
  household           Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  lowStockAutoSuggest Boolean   @default(true)
  priceDropAlerts     Boolean   @default(true)
  warrantyAlerts      Boolean   @default(true)
  recurringPurchases  Boolean   @default(true)
  unusualSpending     Boolean   @default(true)
  upcomingPayments    Boolean   @default(true)
  updatedAt           DateTime  @updatedAt
}

// ==========================================
// RESEARCH EVALUATION & METRICS MODELS
// ==========================================

model ResearchMetric {
  id          String    @id @default(uuid())
  householdId String?
  household   Household? @relation(fields: [householdId], references: [id], onDelete: SetNull)
  category    String    // OCR, PREDICTION, OPTIMIZATION, RECOMMENDATION
  metricName  String
  metricValue Float
  unit        String?
  metadata    String?   // JSON object with additional context
  createdAt   DateTime  @default(now())

  @@index([category])
  @@index([metricName])
}

model OcrEvaluationRecord {
  id                   String    @id @default(uuid())
  householdId          String
  household            Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  receiptId            String?
  receipt              Receipt?  @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  ocrConfidence        Float
  rawText              String
  extractedItemsCount  Int
  correctedItemsCount  Int       @default(0)
  itemAccuracyPercent  Float     @default(100.0)
  storeCorrected       Boolean   @default(false)
  totalAmountCorrected Boolean   @default(false)
  createdAt            DateTime  @default(now())

  @@index([householdId])
}

model PredictionEvaluationRecord {
  id                     String    @id @default(uuid())
  householdId            String
  household              Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  productName            String
  modelType              String    // BASELINE, IMPROVED
  predictedDate          DateTime
  actualPurchaseDate     DateTime?
  errorDays              Float?
  confidence             Float
  suggestionAccepted     Boolean   @default(false)
  historicalPointsCount  Int       @default(0)
  createdAt              DateTime  @default(now())

  @@index([householdId])
  @@index([modelType])
}
